<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

           Title="INSERT HEADER PARAM" Height="367" Width="401" Background="WhiteSmoke">
<Grid>
    <Label Content="ADDING HEADER PARAM" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="344" Height="39" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" FontWeight="Bold"/>
    <ComboBox Name="CmbParamHead" HorizontalAlignment="Center" Margin="0,99,0,0" VerticalAlignment="Top" Width="344" Height="39" SelectedIndex="0" FontSize="20" FontWeight="Bold" BorderBrush="#FFFAFDC3">
        <ComboBoxItem Content="PARAM" />
        <ComboBoxItem Content="Accept" />
        <ComboBoxItem Content="Accept-Encoding" />
        <ComboBoxItem Content="Accept-Language" />
        <ComboBoxItem Content="Cache-Control" />
        <ComboBoxItem Content="Connection" />
        <ComboBoxItem Content="Date" />
        <ComboBoxItem Content="Host" />
        <ComboBoxItem Content="Pragma" />
        <ComboBoxItem Content="Referer" />
        <ComboBoxItem Content="User-Agent" />
        <ComboBoxItem Content="Authorization" />
        <ComboBoxItem Content="Proxy-Authorization" />
        <ComboBoxItem Content="Content-Type" />
        <ComboBoxItem Content="Content-Length" />
        <ComboBoxItem Content="Content-Encoding" />
        <ComboBoxItem Content="Content-Language" />
        <ComboBoxItem Content="Content-Disposition" />
        <ComboBoxItem Content="X-API-Key" />
        <ComboBoxItem Content="X-Auth-Token" />
        <ComboBoxItem Content="X-Request-ID" />
        <ComboBoxItem Content="X-Correlation-ID" />
        <ComboBoxItem Content="Origin" />
        <ComboBoxItem Content="Access-Control-Request-Method" />
        <ComboBoxItem Content="Access-Control-Request-Headers" />
    </ComboBox>
    <Label Content="HEADER:" HorizontalAlignment="Center" Margin="0,49,0,0" VerticalAlignment="Top" Width="344" Height="45" IsEnabled="False" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="18"/>
    <TextBox Name="TxtValueHeader" HorizontalAlignment="Center" Margin="0,193,0,0" TextWrapping="Wrap"       VerticalAlignment="Top" Width="344" Height="59" VerticalContentAlignment="Center" FontSize="16" AcceptsReturn="True" FontWeight="Bold"/>
    <Label Content="VALUE:" HorizontalAlignment="Center" Margin="0,143,0,0" VerticalAlignment="Top" Width="344" Height="45" IsEnabled="False" VerticalContentAlignment="Center" FontWeight="Bold" FontSize="18"/>
    <Button Name="BtnSetValueHeader" Content="SET VALUE" HorizontalAlignment="Center" Margin="0,267,0,0" VerticalAlignment="Top" Width="344" Height="43" Background="#FF569249" FontWeight="Bold" FontSize="24" Foreground="#FFF3F7A1"/>
</Grid>
</Window>