<Window 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

                Title="MainWindow" Height="616" Width="1248" ResizeMode="NoResize">
    <Grid Background="#FFF0F7F7">
        <Label Content="URL:" HorizontalAlignment="Left" Margin="218,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.237,0.477"/>
        <TextBox Name="TxtUrl" HorizontalAlignment="Left" Margin="257,18,0,0" TextWrapping="Wrap" Text="https://pokeapi.co/api/v2/pokemon/ditto" VerticalAlignment="Top" Width="582"/>
        <Button Name="BtnSend" Content="SEND" Margin="22,68,0,479" RenderTransformOrigin="0.494,-0.037" HorizontalAlignment="Left" Width="817" BorderBrush="#FFD0FAE5" Background="#FFD0FAE5"/>
        <ComboBox Name="CmbMethod" HorizontalAlignment="Left" Margin="79,16,0,0" VerticalAlignment="Top" Width="134" RenderTransformOrigin="0.842,0.427" SelectedIndex="0">
            <ComboBoxItem Content="GET"  />
            <ComboBoxItem Content="POST" />
        </ComboBox>
        <Label Content="Method" HorizontalAlignment="Left" Margin="22,14,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.228,0.156"/>
        <ScrollViewer  HorizontalAlignment="Left"
Margin="323,200,0,0"
VerticalAlignment="Top"
Height="368"
Width="915"
VerticalScrollBarVisibility="Auto" 
Foreground="#FFF10A0A">
            <TextBox Name="BlocTextResponse" TextWrapping="Wrap" Text="Response Here!" Width="872" VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" Height="358" Margin="10,0,10,0" RenderTransformOrigin="0.42,0.346" IsReadOnly="True"/>

        </ScrollViewer>
        <ScrollViewer  HorizontalAlignment="Left"
            Margin="10,200,0,0"
            VerticalAlignment="Top"
            Height="368"
            Width="313"
            VerticalScrollBarVisibility="Auto" 
            Foreground="#FFF10A0A">
            <TextBox x:Name="BlocTextHeaders" TextWrapping="Wrap" Text="Headers Here!" Width="290" VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" Height="358" Margin="10,0,10,0" RenderTransformOrigin="0.42,0.346"/>

        </ScrollViewer>
        <ComboBox x:Name="CmbMethod_Copy" HorizontalAlignment="Left" Margin="64,146,0,0" VerticalAlignment="Top" Width="84" RenderTransformOrigin="0.842,0.427" SelectedIndex="0">
            <ComboBoxItem Content="OFF"  />
            <ComboBoxItem Content="JSON"  />
            <ComboBoxItem Content="XML" />
        </ComboBox>
        <Label Content="Body" HorizontalAlignment="Left" Margin="22,144,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.228,0.156"/>
        <Separator HorizontalAlignment="Left" Margin="13,118,0,0" VerticalAlignment="Top" Height="23" RenderTransformOrigin="0.5,0.5" Width="1192">
            <Separator.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Separator.RenderTransform>
        </Separator>
        <TextBox HorizontalAlignment="Left" Margin="872,15,0,0" TextWrapping="Wrap" Text="Data from request Here!" VerticalAlignment="Top" Width="333" Height="21"/>
        <Button x:Name="BtnSave" Content="SAVE" Margin="872,68,0,479" RenderTransformOrigin="0.494,-0.037" HorizontalAlignment="Left" Width="333" BorderBrush="#FFFEF9C2" Background="#FFFEF9C2"/>
        <TextBox HorizontalAlignment="Left" Margin="345,139,0,0" TextWrapping="Wrap" Text="Headers Here!" VerticalAlignment="Top" Width="871" Height="61"/>
        <ComboBox x:Name="CmbMethod_Copy1" HorizontalAlignment="Left" Margin="213,146,0,0" VerticalAlignment="Top" Width="94" RenderTransformOrigin="0.842,0.427" SelectedIndex="1">
            <ComboBoxItem Content="YES"  />
            <ComboBoxItem Content="NO" />
        </ComboBox>
        <Label Content="Edit H" HorizontalAlignment="Left" Margin="166,144,0,0" VerticalAlignment="Top" RenderTransformOrigin="1.228,0.156" Width="42"/>

    </Grid>
</Window>
    