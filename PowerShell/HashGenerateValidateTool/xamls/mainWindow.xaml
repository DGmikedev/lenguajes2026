<Window 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="404" ResizeMode="NoResize">
<Grid Background="#FFDEFDF7">

    <Label Content="Hash Generate\Validate Tool" Margin="0,10,0,0" VerticalAlignment="Top" Width="356" FontWeight="Bold" HorizontalAlignment="Center" HorizontalContentAlignment="Center" FontSize="20"/>
    <Button   Name="BtnOpenFileBrowser" Content="SELECT FILE" Margin="193,94,10,0" VerticalAlignment="Top" RenderTransformOrigin="4.866,1.056" Height="25"/>
    <ComboBox Name="ComboAlgorith" HorizontalAlignment="Left" Margin="10,94,0,0" VerticalAlignment="Top" Width="178" Height="25" SelectedIndex="0" >
        <ComboBoxItem Content="SELECT" />
        <ComboBoxItem Content="SHA1"  />
        <ComboBoxItem Content="SHA256" />
        <ComboBoxItem Content="SHA384" />
        <ComboBoxItem Content="SHA512" />
        <ComboBoxItem Content="MD5" />
    </ComboBox>
    <TextBox Name="TxBoxPathFile" HorizontalAlignment="Center" Margin="0,161,0,0" TextWrapping="Wrap" Text="&#xD;&#xA;" VerticalAlignment="Top" Width="368" Height="51" AcceptsReturn="True" VerticalContentAlignment="Center" IsReadOnly="True" Background="#FFF9FBEE"/>
    <Label Content="ALGORITH                                      FILE" HorizontalAlignment="Center" Margin="0,52,0,0" VerticalAlignment="Top" RenderTransformOrigin="-2.368,0.239" Width="356" Height="32" VerticalContentAlignment="Center" FontWeight="Bold"/>
    <Label Content="PATH FILE SELECTED:" HorizontalAlignment="Left" Margin="10,124,0,0" VerticalAlignment="Top" RenderTransformOrigin="-2.368,0.239" Width="178" Height="32" VerticalContentAlignment="Center" FontWeight="Bold"/>
    <Button Name="BtnLaunchCompare" Content="COMPARE" HorizontalAlignment="Center" Margin="0,361,0,0" VerticalAlignment="Top" RenderTransformOrigin="4.866,1.056" Width="368" Height="40" Background="#FFC3F570" Foreground="#FF3111D2" FontWeight="Bold"/>
    <Label Content="GET / INSERT HASH:" HorizontalAlignment="Left" Margin="10,217,0,0" VerticalAlignment="Top" RenderTransformOrigin="-2.368,0.239" Width="356" Height="32" VerticalContentAlignment="Center" FontWeight="Bold"/>
    <TextBox Name="TxBoxInHash" HorizontalAlignment="Center" Margin="0,249,0,0" TextWrapping="Wrap" Text="&#xA;" VerticalAlignment="Top" Width="368" Height="85" AcceptsReturn="True" VerticalContentAlignment="Center" Background="#FFF9FBEE"/>
    <CheckBox Name="ChkBoxGenerateHash" Content="GENERATE HASH" HorizontalAlignment="Left" Margin="193,124,0,0" VerticalAlignment="Top" Width="193" Height="32" FontWeight="Bold" VerticalContentAlignment="Center"/>
    
</Grid>
</Window>


